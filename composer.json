{
  "name": "esoul/laravel-rabbitmq-roadrunner-driver",
  "description": "Laravel Queue RoadRunner Driver",
  "type": "library",
  "license": "gpl-2.0-or-later",
  "authors": [
    {
      "name": "Tomáš Vojík",
      "email": "vojik@wboy.cz"
    }
  ],
  "require": {
    "php": ">=8.3",
    "php-amqplib/php-amqplib": "^3.7",
    "illuminate/queue": "^12.59",
    "symfony/serializer": "^8",
    "symfony/property-access": "^8",
    "spatie/laravel-package-tools": "^1.16.1",
    "illuminate/support": "^10.2|^11.0|^12.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.13",
    "laravel/framework": "^12.59"
  },
  "autoload": {
    "psr-4": {
      "Esoul\\LaravelRoadrunnerQueueDriver\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "./vendor/bin/phpstan",
    "phpcs": "./vendor/bin/pint --test",
    "cs": "./vendor/bin/pint --test",
    "phpcbf": "./vendor/bin/pint",
    "cbf": "./vendor/bin/pint"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Esoul\\LaravelRoadrunnerQueueDriver\\LaravelQueueRoadrunnerServiceProvider"
      ],
      "aliases": {
      }
    }
  }
}
